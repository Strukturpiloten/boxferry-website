{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Strukturpiloten/boxferry//renovate-presets/common#e1e2980fcdd1c4a90b5672d23402d9f0bdd0fa04"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update explicitly pinned Node setup versions",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+node-version: (?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Poll documentation source main branches",
      "managerFilePatterns": ["/^documentation-sources\\.toml$/"],
      "matchStrings": [
        "name = \"[a-z0-9-]+\"\\nrepository = \"https://github\\.com/(?<depName>Strukturpiloten/[a-z0-9-]+)\\.git\"\\nrevision = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "{{depName}}"
    }
  ],
  "packageRules": [
    {
      "description": "Publish validated documentation source revisions",
      "matchDatasources": ["git-refs"],
      "matchFileNames": ["documentation-sources.toml"],
      "minimumReleaseAge": "0 days",
      "groupName": "documentation sources",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "matchPackageNames": [
        "Strukturpiloten/boxferry",
        "Strukturpiloten/compose-lens",
        "Strukturpiloten/podman-lens",
        "Strukturpiloten/quadlet-lens"
      ]
    }
  ]
}
