{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Berlin",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Signal updates for checksum-pinned file-quality tools",
      "managerFilePatterns": ["/^scripts/install-file-tools\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nreadonly [a-z0-9_]+_version=\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Signal Lychee releases with a checked Linux archive checksum",
      "managerFilePatterns": ["/^scripts/install-file-tools\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>lycheeverse/lychee) releasePrefix=lychee-v\\nreadonly lychee_version=\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^lychee-v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update explicitly pinned Node setup versions",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+node-version: (?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Poll documentation source main branches",
      "managerFilePatterns": ["/^documentation-sources\\.toml$/"],
      "matchStrings": [
        "name = \"(?<depName>[a-z0-9-]+)\"\\nrepository = \"(?<packageName>https://github\\.com/Strukturpiloten/[a-z0-9-]+\\.git)\"\\nrevision = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "depNameTemplate": "Strukturpiloten/boxferry",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "automation-v1",
      "description": "Update the shared automation authority manifest",
      "managerFilePatterns": ["/^\\.github/automation\\.json$/"],
      "matchStrings": [
        "(?<prefix>\"revision\"[ \\t]*:[ \\t]*\")(?<currentDigest>[a-f0-9]{40})(?<suffix>\")"
      ]
    },
    {
      "customType": "regex",
      "depNameTemplate": "Strukturpiloten/boxferry",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "automation-v1",
      "description": "Update the eligibility service automation input",
      "managerFilePatterns": ["/^\\.github/workflows/dependency-eligibility\\.yml$/"],
      "matchStrings": [
        "(?<prefix>(?:^|\\n)[ \\t]*automation-sha:[ \\t]*)(?<currentDigest>[a-f0-9]{40})"
      ]
    },
    {
      "customType": "regex",
      "depNameTemplate": "Strukturpiloten/boxferry",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "automation-v1",
      "description": "Update the annotated immutable shared-source checkout",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "(?<prefix># renovate: datasource=github-digest depName=Strukturpiloten/boxferry currentValue=automation-v1\\n[ \\t]*ref:[ \\t]*)(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group repository Node development-tool updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "Node development tools"
    },
    {
      "description": "Group Python development-tool updates",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "groupName": "Python development tools"
    },
    {
      "description": "Pin every GitHub Action to an immutable commit hash",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge tested non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Do not delay BoxFerry and Lens releases",
      "matchPackageNames": [
        "boxferry",
        "boxferry-model",
        "boxferry-engine",
        "boxferry-compose",
        "boxferry-podman",
        "boxferry-quadlet",
        "compose-lens",
        "podman-lens",
        "quadlet-lens"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Require checksum review for downloaded file-quality tools",
      "matchFileNames": ["scripts/install-file-tools.sh"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Review both Linux release assets and update their SHA-256 checksums before merging."
      ]
    },
    {
      "description": "Publish validated documentation source revisions",
      "matchDatasources": ["git-refs"],
      "matchFileNames": ["documentation-sources.toml"],
      "minimumReleaseAge": "0 days",
      "groupName": "documentation sources",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Bootstrap only: update shared automation pins atomically; common-preset adoption removes this temporary automerge hold",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchDatasources": ["github-digest"],
      "matchPackageNames": ["Strukturpiloten/boxferry"],
      "matchFileNames": [
        ".github/automation.json",
        ".github/workflows/ci.yml",
        ".github/workflows/dependency-eligibility.yml"
      ],
      "groupName": "Shared BoxFerry automation",
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false,
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
